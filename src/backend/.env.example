# MongoDB Connection URI (Atlas connection string or local fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/codinglab

# Port number on which the backend server will run
PORT=5000

# Better Auth Secret (Any random 32-character string for development)
BETTER_AUTH_SECRET=generate-a-random-secret-key-1234567890

# Better Auth Backend URL (URL where the backend server is reachable)
BETTER_AUTH_URL=http://localhost:5000

# GitHub OAuth Credentials
# Register your OAuth application on GitHub developer settings
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth Credentials
# Register your Web Application credentials on Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


# Cloudinary Credentials for image uploads
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dbvburjbc

